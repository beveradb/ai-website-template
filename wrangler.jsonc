{
  // Cloudflare settings for this website.
  // "name" is set by the setup skill to the site's name (lowercase, hyphens).
  "name": "my-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The folder that gets published. Plain HTML sites use ./site;
    // sites with a build step (e.g. Astro) use ./dist — see docs/choosing-a-stack.md.
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
